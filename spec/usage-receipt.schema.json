{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp-spec.local/schemas/v0.1/usage-receipt.schema.json",
  "title": "usage-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "taskId",
        "inputTokens",
        "outputTokens",
        "totalTokens",
        "toolCalls",
        "wallTimeMs",
        "halted"
      ],
      "properties": {
        "type": {
          "const": "UsageReceipt"
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "wallTimeMs": {
          "type": "integer",
          "minimum": 0
        },
        "halted": {
          "type": "boolean"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signerDid",
        "canonicalization",
        "payloadDigest",
        "signedAt",
        "signature"
      ],
      "properties": {
        "signerDid": {
          "type": "string",
          "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]{32,128}$"
        },
        "canonicalization": {
          "const": "RFC8785-JCS"
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "signedAt": {
          "type": "string",
          "format": "date-time"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
